/*****************************************************************************
 * Native/system theme.
 *
 * The frameless combo picker needs an explicit frame; its colors come from
 * the active system palette. All normal widgets remain completely native.
 *****************************************************************************/

#frameTopLevel {
    border: 1px solid palette(mid);
    background-color: palette(window);
}

#editSearch {
    border: 1px solid palette(mid);
    background-color: palette(base);
}

/* Let the native view own its background. Qt's Windows 11 style makes the
 * viewport Base transparent; resolving it back through palette(base) in QSS
 * turns it into black and hides unselected black text in light mode. */
#listViewResults {
    border: 1px solid palette(mid);
}

#labelLogo {
    background-color: transparent;
}
